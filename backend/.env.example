# Salin ke .env lalu sesuaikan. main.go membaca environment langsung —
# gunakan `set -a; source .env; set +a` atau process manager (systemd/docker).

APP_ENV=local            # local | production
HTTP_PORT=8081

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tuleh
DB_PASS=tuleh
DB_NAME=tuleh_pos

# Redis (refresh token + cache)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=
REDIS_DB=1

# Auth — WAJIB diganti di production (boot menolak nilai bawaan)
JWT_SECRET=ganti-di-produksi
ACCESS_TTL_MENIT=15
REFRESH_TTL_HARI=30

# Admin pertama (dibuat hanya saat tabel users kosong)
ADMIN_NAMA="Admin Tuléh"
ADMIN_EMAIL=admin@tuleh.local
ADMIN_PASS=admin1234

# Keamanan HTTP
CORS_ORIGINS=http://localhost:5173
RATE_RPS=20
# ADMIN_DIST: path build admin panel; kosong = API saja
ADMIN_DIST=/srv/tuleh/frontend/dist

# Sinkron dari MOVERA (fase-2) — WAJIB user MySQL SELECT-only
SINKRON_MYSQL_DSN="tuleh_sync:GANTI@tcp(127.0.0.1:3306)/movera_production?parseTime=true"
SINKRON_COMPANY_KODE=TULEH-DEMO
